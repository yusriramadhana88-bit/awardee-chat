# Rename file ini jadi .env.local dan isi semua nilai di bawah ini

# 1. CLAUDE API KEY
# Dari: console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 2. SUPABASE (dari: supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# 3. SUPABASE SERVICE ROLE KEY (dari: supabase.com -> Project Settings -> API -> service_role secret)
# WAJIB diisi — dipakai server untuk update usage harian & cek nomor HP, bypass RLS.
# JANGAN PERNAH expose key ini ke browser/client!
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# 4. DATABASE URL (dari: Supabase Dashboard → Project Settings → Database → URI)
# Hanya dibutuhkan untuk menjalankan migration via: node scripts/run-migration.mjs
# Format: postgresql://postgres.{project-ref}:{db-password}@aws-0-{region}.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
