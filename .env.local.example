# Rename file ini jadi .env.local dan isi semua nilai di bawah ini

# 1. CLAUDE API KEY
# Dari: console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 2. SUPABASE (dari: supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# 3. SUPABASE SERVICE ROLE KEY (dari: supabase.com -> Project Settings -> API -> service_role secret)
# WAJIB diisi — dipakai server untuk update usage harian & cek nomor HP, bypass RLS.
# JANGAN PERNAH expose key ini ke browser/client!
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# 4. DATABASE URL (dari: Supabase Dashboard → Project Settings → Database → URI)
# Hanya dibutuhkan untuk menjalankan migration via: node scripts/run-migration.mjs
# Format: postgresql://postgres.{project-ref}:{db-password}@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 5. TELEGRAM BOT (dari: BotFather setelah bot dibuat)
# Username bot (tanpa @) — dipakai landing page untuk generate link t.me/<username>?start=<leadId>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AwardeeIdBot
# Token bot — HANYA dipakai oleh telegram-bot/ (proses terpisah), JANGAN dipakai di Next.js app
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. LPDP FILE KEY (generate sendiri: 32-byte hex random, misal via `openssl rand -hex 32`)
# Kunci AES-256-GCM untuk enkripsi file LPDP Center & AAS Center sebelum disimpan ke Supabase
# Storage. WAJIB sama antara local dan production (Vercel env) — kalau beda, file lama yang
# disimpan production tidak bisa didekripsi lagi. JANGAN PERNAH commit nilai asli key ini.
LPDP_FILE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 7. RESEND API KEY (dari: resend.com -> API Keys, setelah verifikasi domain pengirim)
# Dipakai untuk kirim email lead magnet otomatis begitu user daftar (lihat lib/email.ts).
# Tanpa ini, registrasi tetap jalan normal — hanya email lead magnet yang di-skip (lihat log server).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 8. INSTAGRAM AUTO-DM (ManyChat-style comment-trigger auto reply + DM) — lihat
# INSTAGRAM_AUTO_DM_SETUP.md untuk cara bikin Meta App-nya dari nol.
INSTAGRAM_PAGE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# Bikin sendiri (string bebas) — dipakai saat verifikasi webhook di Meta App Dashboard
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=pilih-string-rahasia-sendiri
# App Secret dari Meta App Dashboard -> App Settings -> Basic — dipakai verifikasi signature webhook
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 9. LYNK.ID PAYMENT WEBHOOK (auto-upgrade tier saat pembayaran masuk) — lihat
# LYNK_WEBHOOK_SETUP.md untuk cara daftar webhook URL-nya di dashboard lynk.id.
LYNK_MERCHANT_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
