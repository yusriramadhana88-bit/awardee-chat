# Rename jadi .env dan isi

# Dari BotFather setelah bikin bot baru (lihat README.md)
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sama persis dengan yang dipakai di awardee-chat/.env.local — bot ini baca/tulis
# tabel `leads` yang sama dengan yang diisi landing page Next.js
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# URL landing page, dipakai saat bot dapat /start tanpa payload (link tidak valid/kadaluarsa)
LANDING_PAGE_URL=https://awardee.id/lp/aas-interview
